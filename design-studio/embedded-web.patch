diff --git a/apps/web/tests/components/AvatarMenu.kelly.test.tsx b/apps/web/tests/components/AvatarMenu.kelly.test.tsx
new file mode 100644
index 00000000..337c66b1
--- /dev/null
+++ b/apps/web/tests/components/AvatarMenu.kelly.test.tsx
@@ -0,0 +1,72 @@
+// @vitest-environment jsdom
+// @vitest-environment-options {"url":"https://design-studio.localhost/projects/project-a/conversations/chat-a"}
+import { useState } from 'react';
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, expect, it, vi } from 'vitest';
+import { AvatarMenu } from '../../src/components/AvatarMenu';
+import { DEFAULT_CONFIG } from '../../src/state/config';
+import type { AgentInfo } from '../../src/types';
+vi.mock('../../src/i18n', () => ({ useT: () => (key: string) => key }));
+vi.mock('../../src/collab/useWorkspaceContext', () => ({
+  useWorkspaceContext: () => ({ context: null, loading: false }),
+  useWorkspaceBillingResponse: () => null,
+  workspaceBillingSnapshotForContext: () => null,
+}));
+const agents: AgentInfo[] = [
+  { id: 'claude', name: 'Claude Code', bin: 'claude', available: true, models: [{id: 'claude-test', label: 'Claude test'}] },
+  { id: 'codex', name: 'Codex CLI', bin: 'codex', available: true, models: [{id: 'gpt-test', label: 'GPT test'}] },
+  { id: 'missing', name: 'Missing CLI', bin: 'missing', available: false },
+];
+afterEach(cleanup);
+it('opens project execution settings, switches the model catalogue, and preserves the composer', async () => {
+  const onOpenSettings = vi.fn();
+  function Project() {
+    const [agentId, setAgentId] = useState('claude');
+    return <><textarea defaultValue="unsent draft" aria-label="draft" /><AvatarMenu
+      config={{...DEFAULT_CONFIG, mode: 'daemon', agentId}} agents={agents} daemonLive
+      onAgentChange={setAgentId} onAgentModelChange={vi.fn()} onModeChange={vi.fn()}
+      onOpenSettings={onOpenSettings} onRefreshAgents={vi.fn()} /></>;
+  }
+  render(<Project />);
+  const draft = screen.getByLabelText('draft');
+  fireEvent.click(screen.getByTestId('avatar-agent-trigger'));
+  fireEvent.click(screen.getByTestId('avatar-open-execution-settings'));
+  expect(screen.getByTestId('kelly-execution-settings')).toBeTruthy();
+  expect(document.activeElement).toBe(screen.getByTestId('kelly-agent-option-claude'));
+  expect((screen.getByTestId('kelly-agent-option-missing') as HTMLButtonElement).disabled).toBe(true);
+  fireEvent.click(screen.getByTestId('kelly-agent-option-codex'));
+  expect(await screen.findByTestId('avatar-model-option-gpt-test')).toBeTruthy();
+  expect(screen.queryByTestId('avatar-model-option-claude-test')).toBeNull();
+  expect(screen.getByLabelText('draft')).toBe(draft);
+  expect((draft as HTMLTextAreaElement).value).toBe('unsent draft');
+  expect(location.pathname).toBe('/projects/project-a/conversations/chat-a');
+  expect(onOpenSettings).not.toHaveBeenCalled();
+  fireEvent.click(screen.getByTestId('avatar-open-execution-settings'));
+  expect(screen.getByTestId('kelly-agent-option-codex').getAttribute('aria-pressed')).toBe('true');
+  fireEvent.keyDown(document, {key: 'Escape'});
+  expect(screen.queryByTestId('kelly-execution-settings')).toBeNull();
+  expect(document.activeElement).toBe(screen.getByTestId('avatar-agent-trigger'));
+});
+
+it('shows loading and a failed save, retains the old choice, and permits a single retry', async () => {
+  let finish: (() => void) | undefined;
+  const change = vi.fn().mockRejectedValueOnce(new Error('fixture refusal'))
+    .mockImplementationOnce(() => new Promise<void>(resolve => { finish = resolve; }));
+  const props = {config: {...DEFAULT_CONFIG, mode: 'daemon' as const, agentId: 'claude'}, agents, daemonLive:true,
+    onAgentChange:change, onAgentModelChange:vi.fn(), onModeChange:vi.fn(), onOpenSettings:vi.fn(), onRefreshAgents:vi.fn()};
+  const ui = render(<AvatarMenu {...props} agentsLoading />);
+  fireEvent.click(screen.getByTestId('avatar-agent-trigger'));
+  fireEvent.click(screen.getByTestId('avatar-open-execution-settings'));
+  expect(screen.getByRole('status').textContent).toBe('common.loading');
+  ui.rerender(<AvatarMenu {...props} />);
+  fireEvent.click(screen.getByTestId('kelly-agent-option-codex'));
+  expect((await screen.findByRole('alert')).textContent).toBe('avatar.selectionSaveError');
+  expect(screen.getByTestId('kelly-agent-option-claude').getAttribute('aria-pressed')).toBe('true');
+  fireEvent.click(screen.getByTestId('kelly-agent-option-codex'));
+  expect(screen.getByRole('status').textContent).toBe('settings.autosaveSaving');
+  fireEvent.click(screen.getByTestId('kelly-agent-option-codex'));
+  expect(change).toHaveBeenCalledTimes(2);
+  finish!();
+  await waitFor(() => expect(screen.queryByTestId('kelly-execution-settings')).toBeNull());
+  expect(screen.queryByRole('alert')).toBeNull();
+});
diff --git a/apps/web/tests/kelly-embedded-navigation.test.ts b/apps/web/tests/kelly-embedded-navigation.test.ts
new file mode 100644
index 00000000..95b15b80
--- /dev/null
+++ b/apps/web/tests/kelly-embedded-navigation.test.ts
@@ -0,0 +1,24 @@
+// @vitest-environment jsdom
+// @vitest-environment-options {"url":"https://design-studio.localhost/projects/project-a/conversations/chat-a"}
+import { describe, expect, it } from 'vitest';
+import { navigate, parseRoute } from '../src/router';
+
+describe('Kelly embedded project navigation', () => {
+  it('keeps Home, global project creation and foreign projects out of the embedded route', () => {
+    for (const pathname of ['/', '/projects', '/projects/project-b', '/settings', '/marketplace']) {
+      expect(parseRoute(pathname)).toEqual({ kind: 'project', projectId: 'project-a', conversationId: 'chat-a', fileName: null });
+    }
+  });
+  it('preserves conversation and file routes inside the current project', () => {
+    expect(parseRoute('/projects/project-a/conversations/chat-b/files/proof.html')).toEqual({ kind: 'project', projectId: 'project-a', conversationId: 'chat-b', fileName: 'proof.html' });
+  });
+  it('does not commit global navigation after switching conversations', async () => {
+    navigate({ kind: 'project', projectId: 'project-a', conversationId: 'chat-b', fileName: null });
+    await Promise.resolve();
+    expect(location.pathname).toBe('/projects/project-a/conversations/chat-b');
+    navigate({ kind: 'home', view: 'home' });
+    navigate({ kind: 'project', projectId: 'project-b', conversationId: null, fileName: null });
+    await Promise.resolve();
+    expect(location.pathname).toBe('/projects/project-a/conversations/chat-b');
+  });
+});
