+import { expect, it, vi } from 'vitest';
+import { createKellyPanelRatio } from '../src/features/kellyPanelRatio';
+
+it('restores the last ratio after a new view and scales it without saving clamped widths', async () => {
+  let saved: number | undefined;
+  const writes: number[] = [];
+  const request = vi.fn(async (_url: string | URL | Request, init?: RequestInit) => {
+    if (init?.method === 'PUT') { saved = JSON.parse(String(init.body)).chatPanelRatio; writes.push(saved!); }
+    return Response.json({ config: { chatPanelRatio: saved } });
+  });
+  const first = createKellyPanelRatio(request);
+  await first.restore(); expect(first.width(1200)).toBeNull();
+  await first.save(420, 1200);
+  const reopened = createKellyPanelRatio(request);
+  await reopened.restore();
+  expect(reopened.width(1200)).toBe(420);
+  expect(reopened.width(600)).toBe(210);
+  expect(reopened.width(1200)).toBe(420);
+  expect(writes).toEqual([0.35]);
+  await reopened.save(480, 1200);
+  const restarted = createKellyPanelRatio(request);
+  await restarted.restore(); expect(restarted.width(1200)).toBe(480);
+});
+
+it('ignores malformed and out-of-range saved choices', async () => {
+  for (const value of [undefined, null, '0.4', -1, 0, 1, 9]) {
+    const layout=createKellyPanelRatio(async () => Response.json({config:{chatPanelRatio:value}}));
+    await layout.restore(); expect(layout.width(1200)).toBeNull();
+  }
+});
+
+it('does not let a slow initial read replace a newer gesture', async () => {
+  let resolve!: (r: Response) => void;
+  const layout=createKellyPanelRatio((_url, init) => init ? Promise.resolve(Response.json({})) : new Promise(r => {resolve=r;}));
+  const loaded=layout.restore();
+  await layout.save(480,1200);
+  resolve(Response.json({config:{chatPanelRatio:0.2}})); await loaded;
+  expect(layout.width(1200)).toBe(480);
+});
+
+it('serializes successive choices and reports a refused save', async () => {
+  let finish!: (r: Response) => void;
+  const request=vi.fn(() => new Promise<Response>(r => {finish=r;}));
+  const layout=createKellyPanelRatio(request);
+  const first=layout.save(420,1200), second=layout.save(480,1200);
+  await vi.waitFor(() => expect(request).toHaveBeenCalledTimes(1));
+  finish(Response.json({})); await first;
+  await vi.waitFor(() => expect(request).toHaveBeenCalledTimes(2));
+  const rejected=expect(second).rejects.toThrow('Could not save');
+  finish(Response.json({}, {status:503})); await rejected;
+});
