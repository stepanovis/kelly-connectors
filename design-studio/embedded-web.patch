diff --git a/apps/web/src/features/kellyEmbeddedProject.ts b/apps/web/src/features/kellyEmbeddedProject.ts
new file mode 100644
index 00000000..5a28bb8d
--- /dev/null
+++ b/apps/web/src/features/kellyEmbeddedProject.ts
@@ -0,0 +1,22 @@
+// Kelly owns project selection. Its dedicated origin is installed by the
+// desktop session protocol; ordinary standalone Studio keeps its navigation.
+// This is a presentation mode, not an authorization boundary. The desktop
+// StudioProjectSurface continues to enforce every project/data request.
+import type { Route } from '../router';
+
+const initialLocation = typeof window === 'undefined' ? null : window.location;
+const initialParts = initialLocation?.pathname.split('/').filter(Boolean) ?? [];
+export const KELLY_EMBEDDED_PROJECT = initialLocation?.origin === 'https://design-studio.localhost'
+  && initialParts[0] === 'projects' && Boolean(initialParts[1]);
+const projectId = KELLY_EMBEDDED_PROJECT && initialParts[1] ? decodeURIComponent(initialParts[1]) : null;
+const initialConversationId = KELLY_EMBEDDED_PROJECT && initialParts[2] === 'conversations'
+  && initialParts[3] ? decodeURIComponent(initialParts[3]) : null;
+
+export function embeddedProjectRoute(route: Route): Route {
+  if (!projectId || (route.kind === 'project' && route.projectId === projectId)) return route;
+  return { kind: 'project', projectId, conversationId: initialConversationId, fileName: null };
+}
+
+export function allowsEmbeddedNavigation(route: Route): boolean {
+  return !projectId || (route.kind === 'project' && route.projectId === projectId);
+}
diff --git a/apps/web/src/features/kellyPanelRatio.ts b/apps/web/src/features/kellyPanelRatio.ts
new file mode 100644
index 00000000..d0b92c9b
--- /dev/null
+++ b/apps/web/src/features/kellyPanelRatio.ts
@@ -0,0 +1,38 @@
+// Kelly's project surface persists this preference with the project's other
+// settings. A temporary browser session must not be the source of truth.
+export function validPanelRatio(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value > 0 && value < 1;
+}
+
+export function createKellyPanelRatio(request: typeof fetch = fetch) {
+  let ratio: number | null = null;
+  let changed = false;
+  let pending = Promise.resolve();
+  return {
+    width(available: number): number | null {
+      return ratio === null ? null : ratio * available;
+    },
+    async restore(): Promise<void> {
+      const response = await request('/api/app-config');
+      if (!response.ok) throw new Error('Could not read Studio layout');
+      const { config } = await response.json();
+      if (!changed && validPanelRatio(config?.chatPanelRatio)) ratio = config.chatPanelRatio;
+    },
+    save(width: number, available: number): Promise<void> {
+      const next = width / available;
+      if (!validPanelRatio(next)) return Promise.resolve();
+      changed = true;
+      ratio = next;
+      // Preserve the order of successive user gestures. Automatic clamping
+      // and window resizes only call width(), never write a preference.
+      pending = pending.catch(() => {}).then(async () => {
+        const response = await request('/api/app-config', {
+          method: 'PUT', headers: { 'content-type': 'application/json' },
+          body: JSON.stringify({ chatPanelRatio: next }), keepalive: true,
+        });
+        if (!response.ok) throw new Error('Could not save Studio layout');
+      });
+      return pending;
+    },
+  };
+}
